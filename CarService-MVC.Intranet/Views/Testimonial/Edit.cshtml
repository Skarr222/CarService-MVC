@{
    ViewData["Title"] = "Edytuj opinię";
}

<div class="table-card" style="max-width: 700px;">
    <div class="table-header">
        <h5><i class="bi bi-star me-2"></i>Edytuj opinię</h5>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Wróć
        </a>
    </div>
    <div class="p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" name="Id" />
            <div class="mb-3">
                <label class="form-label">Imię klienta</label>
                <input name="ClientName" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Treść opinii</label>
                <textarea name="Content" class="form-control" rows="4"></textarea>
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label class="form-label">Ocena (1-5)</label>
                    <input name="Rating" type="number" min="1" max="5" class="form-control" />
                </div>
                <div class="col d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input name="IsApproved" type="checkbox" class="form-check-input" id="isApproved" />
                        <label class="form-check-label" for="isApproved">Zatwierdzona</label>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary-custom">Zapisz</button>
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>
