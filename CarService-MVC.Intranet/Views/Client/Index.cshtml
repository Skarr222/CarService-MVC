@model List<Client>
@{
    ViewData["Title"] = "Klienci";
    Layout = "_Layout";
}

<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-people me-2"></i>Lista klientów</h5>
        <a asp-action="Create" class="btn btn-primary-custom btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Dodaj klienta
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>#</th>
                <th>Imię i nazwisko</th>
                <th>Telefon</th>
                <th>E-mail</th>
                <th>Pojazdy</th>
                <th>Status</th>
                <th>Akcje</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">Brak danych</td>
                </tr>
            }
            @foreach (var client in Model)
            {
                <tr>
                    <td><strong>@client.Id</strong></td>
                    <td>@client.FirstName @client.LastName</td>
                    <td>@client.Phone</td>
                    <td>@client.Email</td>
                    <td><span class="badge-status badge-nowe">@client.Vehicles.Count pojazd(ów)</span></td>
                    <td>
                        @if (client.IsActive)
                        {
                            <span class="badge-status badge-nowe">Aktywny</span>
                        }
                        else
                        {
                            <span class="badge-status badge-anulowane">Nieaktywny</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@client.Id" class="btn-action edit"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="@client.Id" class="btn-action delete"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
