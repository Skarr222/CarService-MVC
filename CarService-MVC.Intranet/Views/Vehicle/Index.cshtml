@model List<CarService_MVC.Data.Models.Vehicle>
@{
    ViewData["Title"] = "Pojazdy";
}

<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-car-front me-2"></i>Lista pojazdów</h5>
        <a asp-action="Create" class="btn btn-primary-custom btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Dodaj pojazd
        </a>
    </div>
    <form method="get" class="d-flex gap-2 px-3 pb-3">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Szukaj pojazdu..." />
        <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i></button>
        @if (!string.IsNullOrEmpty((string?)ViewBag.Search))
        {
            <a asp-action="Index" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i></a>
        }
    </form>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>#</th>
                <th>Klient</th>
                <th>Marka / Model</th>
                <th>Rok</th>
                <th>Rejestracja</th>
                <th>Silnik</th>
                <th>Akcje</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var vehicle in Model!)
            {
                <tr>
                    <td><strong>@vehicle.Id</strong></td>
                    <td>@vehicle.Client.FirstName @vehicle.Client.LastName</td>
                    <td>@vehicle.Brand / @vehicle.Model</td>
                    <td>@vehicle.Year</td>
                    <td>@vehicle.LicensePlate</td>
                    <td>@vehicle.EngineType</td>
                    <td>
                        <a asp-controller="Vehicle" asp-action="Edit" asp-route-id="@vehicle.Id"
                           class="btn-action edit"><i class="bi bi-pencil"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
