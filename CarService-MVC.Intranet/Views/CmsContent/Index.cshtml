@model List<CmsContent>
@{
    ViewData["Title"] = "Treści CMS";
}

<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-file-earmark-text me-2"></i>Treści CMS</h5>
        <a asp-action="Create" class="btn btn-primary-custom btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Dodaj treść
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>#</th>
                <th>Klucz</th>
                <th>Tytuł</th>
                <th>Sekcja</th>
                <th>Kolejność</th>
                <th>Aktywny</th>
                <th>Zaktualizowano</th>
                <th>Akcje</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">Brak danych</td>
                </tr>
            }
            @foreach (var content in Model)
            {
                <tr>
                    <td><strong>@content.Id</strong></td>
                    <td><code>@content.Key</code></td>
                    <td>@content.Title</td>
                    <td>@content.Section</td>
                    <td>@content.SortOrder</td>
                    <td>
                        @if (content.IsActive)
                        {
                            <span class="badge-status badge-zakonczone">Tak</span>
                        }
                        else
                        {
                            <span class="badge-status badge-anulowane">Nie</span>
                        }
                    </td>
                    <td>@content.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@content.Id" class="btn-action edit"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="@content.Id" class="btn-action delete"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
