@model List<Service>
@{
    ViewData["Title"] = "Usługi";
}

<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-wrench me-2"></i>Lista usług</h5>
        <a asp-action="Create" class="btn btn-primary-custom btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Dodaj usługę
        </a>
    </div>
    <form method="get" class="d-flex gap-2 px-3 pb-3">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Szukaj usługi..." />
        <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i></button>
        @if (!string.IsNullOrEmpty((string?)ViewBag.Search))
        {
            <a asp-action="Index" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i></a>
        }
    </form>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>#</th>
                <th>Nazwa</th>
                <th>Kategoria</th>
                <th>Opis</th>
                <th>Cena</th>
                <th>Czas (min)</th>
                <th>Akcje</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">Brak danych</td>
                </tr>
            }
            @foreach (var service in Model)
            {
                <tr>
                    <td><strong>@service.Id</strong></td>
                    <td>@service.Name</td>
                    <td>@service.ServiceCategory.Name</td>
                    <td>@service.Description</td>
                    <td>@service.EstimatedPrice.ToString("C")</td>
                    <td>@service.EstimatedDuration</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@service.Id" class="btn-action edit"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="@service.Id" class="btn-action delete"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
