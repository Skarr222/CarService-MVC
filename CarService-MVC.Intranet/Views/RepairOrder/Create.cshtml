@using System.Globalization
@{
    ViewData["Title"] = "Dodaj zlecenie";
    var services = ViewBag.Services as List<ServiceSelectionItem> ?? new List<ServiceSelectionItem>();
    var vehicleOptions = ViewBag.VehicleOptions as List<VehicleOption> ?? new List<VehicleOption>();
    var clientOptions = ViewBag.Clients as SelectList ?? new SelectList(Enumerable.Empty<object>());
}

<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-clipboard-check me-2"></i>Dodaj zlecenie</h5>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Wróć
        </a>
    </div>
    <div class="p-4">
        <form asp-action="Create" method="post">
            <div class="row mb-3">
                <div class="col">
                    <label class="form-label">Klient</label>
                    <select name="ClientId" id="clientSelect" class="form-select">
                        <option value="">Wybierz klienta</option>
                        @foreach (var item in clientOptions)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col">
                    <label class="form-label">Pojazd</label>
                    <select name="VehicleId" id="vehicleSelect" class="form-select">
                        <option value="">Wybierz pojazd</option>
                        @foreach (var vehicle in vehicleOptions)
                        {
                            <option value="@vehicle.Id" data-client-id="@vehicle.ClientId">@vehicle.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label class="form-label">Pracownik</label>
                    <select name="EmployeeId" class="form-select" asp-items="ViewBag.Employees">
                        <option value="">Wybierz pracownika</option>
                    </select>
                </div>
                <div class="col">
                    <label class="form-label">Status</label>
                    <select name="Status" class="form-select" asp-items="ViewBag.Statuses"></select>
                </div>
                <div class="col">
                    <label class="form-label">Planowana data</label>
                    <input name="PlannedDate" type="date" class="form-control"/>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Opis</label>
                <textarea name="Description" class="form-control" rows="3"></textarea>
            </div>
            @if (services.Any())
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold">Usługi</label>
                    <table class="table table-sm table-bordered" id="servicesTable">
                        <thead class="table-light">
                        <tr>
                            <th style="width:2rem"></th>
                            <th>Kategoria / Usługa</th>
                            <th style="width:8rem">Cena jedn. (zł)</th>
                            <th style="width:6rem">Ilość</th>
                            <th style="width:8rem" class="text-end">Wartość</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var s in services)
                        {
                            <tr data-service-row>
                                <td class="text-center">
                                    <input type="checkbox" name="ServiceIds" value="@s.ServiceId"
                                           class="form-check-input svc-check"/>
                                </td>
                                <td>
                                    <small class="text-muted">@s.CategoryName</small><br/>
                                    @s.Name
                                </td>
                                <td>
                                    <input type="number" name="ServicePrice_@s.ServiceId"
                                           value="@s.EstimatedPrice.ToString("F2", CultureInfo.InvariantCulture)"
                                           step="0.01" min="0" class="form-control form-control-sm svc-price"/>
                                </td>
                                <td>
                                    <input type="number" name="ServiceQty_@s.ServiceId"
                                           value="1" min="1" class="form-control form-control-sm svc-qty"/>
                                </td>
                                <td class="text-end align-middle svc-line">—</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            <div class="mb-3">
                <label class="form-label">Uwagi</label>
                <textarea name="Notes" class="form-control" rows="2"></textarea>
            </div>
            <div class="row mb-4 align-items-end">
                <div class="col-auto ms-auto" style="min-width:220px">
                    <label class="form-label fw-semibold">Koszt całkowity (zł)</label>
                    <input name="TotalCost" id="totalCost" type="text" readonly
                           class="form-control-plaintext fw-semibold fs-5" value="0.00 zł"/>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary-custom">Zapisz</button>
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/RepairOrder/client-vehicle-filter.js" asp-append-version="true"></script>
    <script src="~/js/RepairOrder/services-calc.js" asp-append-version="true"></script>
}
