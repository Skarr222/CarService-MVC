@model Testimonial
@{
    ViewData["Title"] = "Edytuj opinię";
}

<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-star me-2"></i>Edytuj opinię</h5>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Wróć
        </a>
    </div>
    <div class="p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="mb-3">
                <label class="form-label">Imię klienta</label>
                <input name="ClientName" class="form-control" value="@Model.ClientName" />
            </div>
            <div class="mb-3">
                <label class="form-label">Treść opinii</label>
                <textarea name="Content" class="form-control" rows="4">@Model.Content</textarea>
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label class="form-label">Status zatwierdzenia</label>
                    <select name="IsApproved" class="form-select">
                        @if (Model.IsApproved)
                        {
                            <option value="true" selected>Zatwierdzona</option>
                            <option value="false">Oczekuje</option>
                        }
                        else
                        {
                            <option value="true">Zatwierdzona</option>
                            <option value="false" selected>Oczekuje</option>
                        }
                    </select>
                </div>
                <div class="col">
                    <label class="form-label">Ocena</label>
                    <input type="hidden" name="Rating" value="@Model.Rating" />
                    <div class="form-control-plaintext">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="bi bi-star@(i <= Model.Rating ? "-fill" : "") text-warning fs-5"></i>
                        }
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary-custom">Zapisz</button>
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>
