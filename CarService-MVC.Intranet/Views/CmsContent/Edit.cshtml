@model CmsContent
@{
    ViewData["Title"] = "Edytuj treść CMS";
}

<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-file-earmark-text me-2"></i>Edytuj treść CMS</h5>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Wróć
        </a>
    </div>
    <div class="p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="row mb-3">
                <div class="col">
                    <label class="form-label">Klucz</label>
                    <input name="Key" class="form-control" value="@Model.Key" />
                </div>
                <div class="col">
                    <label class="form-label">Sekcja</label>
                    <input name="Section" class="form-control" value="@Model.Section" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Tytuł</label>
                <input name="Title" class="form-control" value="@Model.Title" />
            </div>
            <div class="mb-3">
                <label class="form-label">Treść</label>
                <textarea name="Content" class="form-control" rows="5">@Model.Content</textarea>
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label class="form-label">Kolejność</label>
                    <input name="SortOrder" type="number" class="form-control" value="@Model.SortOrder" />
                </div>
                <div class="col d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input name="IsActive" type="checkbox" value="true" class="form-check-input" id="isActive" @(Model.IsActive ? "checked" : "") />
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check-label" for="isActive">Aktywny</label>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary-custom">Zapisz</button>
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>
