@{
    ViewData["Title"] = "Wiadomości";
}

<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-envelope me-2"></i>Wiadomości kontaktowe</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>#</th>
                <th>Nadawca</th>
                <th>E-mail</th>
                <th>Temat</th>
                <th>Data</th>
                <th>Status</th>
                <th>Akcje</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td colspan="7" class="text-center text-muted py-4">Brak danych</td>
            </tr>
            </tbody>
        </table>
    </div>
</div>
