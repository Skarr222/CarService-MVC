@model List<RepairOrder>
@{
    ViewData["Title"] = "Zlecenia napraw";
}
<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-clipboard-check me-2"></i>Lista zleceń</h5>
        <div class="d-flex gap-2">
            <a asp-action="ExportCsv" class="btn btn-outline-success btn-sm">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Eksport CSV
            </a>
            <a asp-action="Create" class="btn btn-primary-custom btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Dodaj zlecenie
            </a>
        </div>
    </div>
    <form method="get" class="d-flex gap-2 px-3 pb-3">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm"
               placeholder="Szukaj zlecenia..."/>
        <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i></button>
        @if (!string.IsNullOrEmpty((string?)ViewBag.Search))
        {
            <a asp-action="Index" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i></a>
        }
    </form>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>#</th>
                <th>Klient</th>
                <th>Pojazd</th>
                <th>Opis</th>
                <th>Status</th>
                <th>Data</th>
                <th>Koszt</th>
                <th>Akcje</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">Brak danych</td>
                </tr>
            }
            @foreach (var order in Model)
            {
                <tr>
                    <td><strong>@order.Id</strong></td>
                    <td>@order.Client.FirstName @order.Client.LastName</td>
                    <td>@order.Vehicle.Brand @order.Vehicle.Model (@order.Vehicle.LicensePlate)</td>
                    <td>@order.Description</td>
                    <td>
                        @{
                            var (badgeClass, badgeLabel) = order.Status switch
                            {
                                RepairOrderStatus.New => ("badge-nowe", "Nowe"),
                                RepairOrderStatus.InProgress => ("badge-wtrakcie", "W trakcie"),
                                RepairOrderStatus.Completed => ("badge-gotowe", "Zakończone"),
                                RepairOrderStatus.Cancelled => ("badge-anulowane", "Anulowane"),
                                RepairOrderStatus.Ready => ("badge-gotowe", "Gotowe"),
                                RepairOrderStatus.Released => ("badge-wydane", "Wydane"),
                                _ => ("badge-nowe", ((int)order.Status).ToString())
                            };
                        }
                        <span class="badge-status @badgeClass">@badgeLabel</span>
                    </td>
                    <td>@order.CreatedAt.ToString("dd.MM.yyyy")</td>
                    <td>@(order.TotalCost.HasValue ? order.TotalCost.Value.ToString("C") : "-")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@order.Id" class="btn-action edit"><i
                                class="bi bi-pencil"></i></a>
                        <a asp-action="History" asp-route-id="@order.Id" class="btn-action"><i
                                class="bi bi-clock-history"></i></a>
                        <a asp-action="Photos" asp-route-id="@order.Id" class="btn-action"><i class="bi bi-images"></i></a>
                        <a asp-action="Delete" asp-route-id="@order.Id" class="btn-action delete"><i
                                class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
