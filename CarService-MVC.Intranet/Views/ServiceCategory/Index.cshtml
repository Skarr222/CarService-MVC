@model List<ServiceCategory>
@{
    ViewData["Title"] = "Kategorie usług";
}

<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-folder me-2"></i>Kategorie usług</h5>
        <a asp-action="Create" class="btn btn-primary-custom btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Dodaj kategorię
        </a>
    </div>
    <form method="get" class="d-flex gap-2 px-3 pb-3">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Szukaj kategorii..." />
        <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i></button>
        @if (!string.IsNullOrEmpty((string?)ViewBag.Search))
        {
            <a asp-action="Index" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i></a>
        }
    </form>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>#</th>
                <th>Nazwa</th>
                <th>Opis</th>
                <th>Ikona</th>
                <th>Liczba usług</th>
                <th>Akcje</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Brak danych</td>
                </tr>
            }
            @foreach (var category in Model)
            {
                <tr>
                    <td><strong>@category.Id</strong></td>
                    <td>
                        @if (!string.IsNullOrEmpty(category.IconCss))
                        {
                            <i class="@category.IconCss me-2"></i>
                        }
                        @category.Name
                    </td>
                    <td>@category.Description</td>
                    <td><code>@category.IconCss</code></td>
                    <td><span class="badge-status badge-nowe">@category.Services.Count</span></td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn-action edit"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="@category.Id" class="btn-action delete"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
