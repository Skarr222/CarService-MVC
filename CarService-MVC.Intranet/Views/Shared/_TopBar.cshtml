<header class="topbar">
    <div class="topbar-left">
        <button class="sidebar-toggle" id="sidebarToggle">
            <i class="bi bi-list"></i>
        </button>
        <h1 class="topbar-title">@ViewData["Title"]</h1>
    </div>
    <div class="topbar-right">
        <a asp-controller="ContactRequest" asp-action="Index" class="topbar-icon" title="Wiadomości">
            <i class="bi bi-envelope"></i>
        </a>
        <a href="http://localhost:5170" target="_blank" class="topbar-icon" title="Otwórz Portal">
            <i class="bi bi-box-arrow-up-right"></i>
        </a>
    </div>
</header>