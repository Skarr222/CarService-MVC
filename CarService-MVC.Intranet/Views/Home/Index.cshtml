@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card-stat">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">12</div>
                    <div class="stat-label">Aktywne zlecenia</div>
                </div>
                <div class="stat-icon" style="background: rgba(37,99,235,0.1); color: var(--primary);">
                    <i class="bi bi-clipboard-check"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-stat">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">8</div>
                    <div class="stat-label">Klienci</div>
                </div>
                <div class="stat-icon" style="background: rgba(16,185,129,0.1); color: var(--success);">
                    <i class="bi bi-people"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-stat">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">3</div>
                    <div class="stat-label">Zaplanowane dziś</div>
                </div>
                <div class="stat-icon" style="background: rgba(245,158,11,0.1); color: var(--accent);">
                    <i class="bi bi-calendar-event"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-stat">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-value">2</div>
                    <div class="stat-label">Nowe wiadomości</div>
                </div>
                <div class="stat-icon" style="background: rgba(239,68,68,0.1); color: var(--danger);">
                    <i class="bi bi-envelope"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-clipboard-check me-2"></i>Ostatnie zlecenia</h5>
        <a asp-controller="RepairOrder" asp-action="Index" class="btn btn-primary-custom btn-sm">
            Zobacz wszystkie <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>#</th>
                <th>Klient</th>
                <th>Pojazd</th>
                <th>Opis</th>
                <th>Status</th>
                <th>Data</th>
                <th>Akcje</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td><strong>#5</strong></td>
                <td>Robert Kamiński</td>
                <td>Skoda Octavia (2022)</td>
                <td>Diagnostyka — kontrolka silnika</td>
                <td><span class="badge-status badge-wtrakcie">W trakcie</span></td>
                <td>20.02.2026</td>
                <td>
                    <a href="#" class="btn-action view"><i class="bi bi-eye"></i></a>
                    <a href="#" class="btn-action edit"><i class="bi bi-pencil"></i></a>
                </td>
            </tr>
            <tr>
                <td><strong>#8</strong></td>
                <td>Michał Jankowski</td>
                <td>Hyundai Tucson (2023)</td>
                <td>Przegląd techniczny + wymiana oleju</td>
                <td><span class="badge-status badge-wtrakcie">W trakcie</span></td>
                <td>26.02.2026</td>
                <td>
                    <a href="#" class="btn-action view"><i class="bi bi-eye"></i></a>
                    <a href="#" class="btn-action edit"><i class="bi bi-pencil"></i></a>
                </td>
            </tr>
            <tr>
                <td><strong>#7</strong></td>
                <td>Ewa Szymańska</td>
                <td>Opel Astra (2016)</td>
                <td>Klimatyzacja nie chłodzi</td>
                <td><span class="badge-status badge-nowe">Nowe</span></td>
                <td>27.02.2026</td>
                <td>
                    <a href="#" class="btn-action view"><i class="bi bi-eye"></i></a>
                    <a href="#" class="btn-action edit"><i class="bi bi-pencil"></i></a>
                </td>
            </tr>
            <tr>
                <td><strong>#4</strong></td>
                <td>Katarzyna Wójcik</td>
                <td>BMW 320d (2017)</td>
                <td>Wymiana rozrządu — 180 tys. km</td>
                <td><span class="badge-status badge-gotowe">Gotowe</span></td>
                <td>15.01.2026</td>
                <td>
                    <a href="#" class="btn-action view"><i class="bi bi-eye"></i></a>
                    <a href="#" class="btn-action edit"><i class="bi bi-pencil"></i></a>
                </td>
            </tr>
            <tr>
                <td><strong>#11</strong></td>
                <td>Maria Kowalczyk</td>
                <td>Volkswagen Golf (2018)</td>
                <td>Wymiana tarcz hamulcowych przód</td>
                <td><span class="badge-status badge-oczekiwanie">Oczekiwanie</span></td>
                <td>15.02.2026</td>
                <td>
                    <a href="#" class="btn-action view"><i class="bi bi-eye"></i></a>
                    <a href="#" class="btn-action edit"><i class="bi bi-pencil"></i></a>
                </td>
            </tr>
            </tbody>
        </table>
    </div>
</div>
