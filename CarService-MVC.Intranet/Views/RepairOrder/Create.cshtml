@{
    ViewData["Title"] = "Dodaj zlecenie";
}

<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-clipboard-check me-2"></i>Dodaj zlecenie</h5>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Wróć
        </a>
    </div>
    <div class="p-4">
        <form asp-action="Create" method="post">
            <div class="row mb-3">
                <div class="col">
                    <label class="form-label">Klient</label>
                    <select name="ClientId" class="form-select"></select>
                </div>
                <div class="col">
                    <label class="form-label">Pojazd</label>
                    <select name="VehicleId" class="form-select"></select>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label class="form-label">Pracownik</label>
                    <select name="EmployeeId" class="form-select"></select>
                </div>
                <div class="col">
                    <label class="form-label">Status</label>
                    <select name="Status" class="form-select"></select>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Opis</label>
                <textarea name="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label class="form-label">Planowana data</label>
                    <input name="PlannedDate" type="date" class="form-control" />
                </div>
                <div class="col">
                    <label class="form-label">Koszt całkowity</label>
                    <input name="TotalCost" type="number" step="0.01" class="form-control" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Uwagi</label>
                <textarea name="Notes" class="form-control" rows="2"></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary-custom">Zapisz</button>
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>
