@{
    ViewData["Title"] = "Usuń pracownika";
}

<div class="table-card" style="max-width: 500px;">
    <div class="table-header">
        <h5><i class="bi bi-trash me-2"></i>Usuń pracownika</h5>
    </div>
    <div class="p-4">
        <p class="text-muted">Czy na pewno chcesz usunąć tego pracownika? Operacja jest nieodwracalna.</p>
        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" name="id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Usuń</button>
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>
