@{
    ViewData["Title"] = "Edytuj kategorię";
}

<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-folder me-2"></i>Edytuj kategorię usług</h5>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Wróć
        </a>
    </div>
    <div class="p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" name="Id" />
            <div class="mb-3">
                <label class="form-label">Nazwa</label>
                <input name="Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Opis</label>
                <textarea name="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Ikona CSS (Bootstrap Icons)</label>
                <input name="IconCss" class="form-control" placeholder="np. bi bi-wrench" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary-custom">Zapisz</button>
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>
