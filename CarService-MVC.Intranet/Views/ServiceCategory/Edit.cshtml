@model ServiceCategory
@{
    ViewData["Title"] = "Edytuj kategorię";
}

<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-folder me-2"></i>Edytuj kategorię usług</h5>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Wróć
        </a>
    </div>
    <div class="p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="mb-3">
                <label class="form-label">Nazwa</label>
                <input name="Name" class="form-control" value="@Model.Name" />
            </div>
            <div class="mb-3">
                <label class="form-label">Opis</label>
                <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Ikona</label>
                <input type="hidden" name="IconCss" id="iconCssInput" value="@Model.IconCss" />
                <div id="iconPicker" class="d-flex flex-wrap gap-2 p-3 border rounded bg-light">
                    @foreach (var icon in new[] {
                        "bi-wrench","bi-wrench-adjustable","bi-tools","bi-gear","bi-gear-wide-connected",
                        "bi-car-front","bi-car-front-fill","bi-truck","bi-fuel-pump","bi-speedometer2",
                        "bi-disc","bi-lightning-charge","bi-battery-half","bi-thermometer-half",
                        "bi-droplet","bi-wind","bi-snow","bi-sun","bi-fire","bi-cpu",
                        "bi-shield-check","bi-clipboard-check","bi-hammer","bi-stars","bi-camera"
                    })
                    {
                        <button type="button" class="btn btn-outline-secondary icon-opt"
                                data-icon="bi @icon" title="@icon">
                            <i class="bi @icon fs-5"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary-custom">Zapisz</button>
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>

<script>
(function () {
    var input = document.getElementById('iconCssInput');

    function selectIcon(val) {
        document.querySelectorAll('.icon-opt').forEach(function (b) {
            b.classList.toggle('icon-opt-selected', b.dataset.icon === val);
        });
        input.value = val;
    }

    document.querySelectorAll('.icon-opt').forEach(function (btn) {
        btn.addEventListener('click', function () { selectIcon(this.dataset.icon); });
    });

    if (input.value) selectIcon(input.value);
})();
</script>

<style>
    .icon-opt { width: 2.8rem; height: 2.8rem; padding: 0; display: inline-flex; align-items: center; justify-content: center; }
    .icon-opt-selected { background-color: var(--primary) !important; color: #fff !important; border-color: var(--primary) !important; box-shadow: 0 0 0 3px rgba(37,99,235,.25); }
</style>
