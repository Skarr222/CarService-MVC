@model List<Employee>
@{
    ViewData["Title"] = "O nas";
    var cms = (Dictionary<string, string>)(ViewBag.Cms ?? new Dictionary<string, string>());
    string Cms(string key, string fallback = "") => cms.TryGetValue(key, out var v) ? v : fallback;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/about.css" asp-append-version="true" />
}

<!-- Page Hero -->
<section class="page-hero">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-custom mb-3">
                <li class="breadcrumb-item"><a asp-action="Index">Strona główna</a></li>
                <li class="breadcrumb-item active">O nas</li>
            </ol>
        </nav>
        <h1 class="fade-up">O <span>nas</span></h1>
        <p class="fade-up fade-up-delay-1">
            @Cms("intro.subtitle")
        </p>
    </div>
</section>

<!-- Mission Section -->
<section class="section-mission">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 fade-up">
                <p class="overline-label"><i class="bi bi-award-fill"></i> Nasza historia</p>
                <h2 class="section-title">Nasza <span>misja</span></h2>
                <p class="mission-text mt-4">
                    @Cms("mission.content")
                </p>
                <p class="mission-text">
                    @Cms("mission.content2")
                </p>
                <div class="d-flex gap-3 mt-4">
                    <a asp-action="Book" class="btn-cta-lg"><i class="bi bi-calendar-check"></i> Umów wizytę</a>
                    <a asp-action="Contact" class="btn btn-outline-secondary btn-lg px-4">Kontakt</a>
                </div>
            </div>
            <div class="col-lg-6 fade-up fade-up-delay-2">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="stat-box">
                            <div class="stat-number-lg">15+</div>
                            <div class="stat-label-sm">Lat doświadczenia</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-box stat-box-accent">
                            <div class="stat-number-lg">8k+</div>
                            <div class="stat-label-sm">Naprawionych aut</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-box stat-box-accent">
                            <div class="stat-number-lg">4.9★</div>
                            <div class="stat-label-sm">Ocena klientów</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-box">
                            <div class="stat-number-lg">12m</div>
                            <div class="stat-label-sm">Gwarancja na naprawy</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Values Section -->
<section class="section-values">
    <div class="container">
        <div class="text-center mb-5 fade-up">
            <h2 class="section-title">Nasze <span>wartości</span></h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4 fade-up fade-up-delay-1">
                <div class="value-card">
                    <div class="value-icon" style="background:rgba(37,99,235,0.1);color:var(--primary)">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h5>Jakość</h5>
                    <p>@Cms("values.quality")</p>
                </div>
            </div>
            <div class="col-md-4 fade-up fade-up-delay-2">
                <div class="value-card">
                    <div class="value-icon" style="background:rgba(245,158,11,0.1);color:var(--accent)">
                        <i class="bi bi-hand-thumbs-up"></i>
                    </div>
                    <h5>Uczciwość</h5>
                    <p>@Cms("values.honesty")</p>
                </div>
            </div>
            <div class="col-md-4 fade-up fade-up-delay-3">
                <div class="value-card">
                    <div class="value-icon" style="background:rgba(16,185,129,0.1);color:#10b981">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h5>Klient na pierwszym miejscu</h5>
                    <p>@Cms("values.customer")</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Team Section -->
@if (Model.Any())
{
    <section class="section-team">
        <div class="container">
            <div class="text-center mb-5 fade-up">
                <h2 class="section-title">Nasz <span>zespół</span></h2>
                <p class="section-subtitle mx-auto mt-3">
                    @Cms("team.subtitle")
                </p>
            </div>
            <div class="row g-4 justify-content-center">
                @foreach (var (emp, idx) in Model.Select((e, i) => (e, i)))
                {
                    <div class="col-sm-6 col-lg-3 fade-up" style="animation-delay: @(idx * 0.1)s">
                        <div class="team-card">
                            <div class="team-avatar">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <h5 class="team-name">@emp.FirstName @emp.LastName</h5>
                            <p class="team-position">@emp.Position</p>
                            @if (!string.IsNullOrEmpty(emp.Email))
                            {
                                <a href="mailto:@emp.Email" class="team-email">
                                    <i class="bi bi-envelope"></i> @emp.Email
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
