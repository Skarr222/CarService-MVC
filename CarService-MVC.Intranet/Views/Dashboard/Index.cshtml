@using CarService_MVC.Data.Models
@model DashboardViewModel

@{
    ViewData["Title"] = "Panel Główny";
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card-stat">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Aktywne zlecenia</div>
                    <div class="stat-value">@Model.OpenOrders</div>
                </div>
                <div class="stat-icon" style="background: rgba(37,99,235,0.1); color: var(--primary);">
                    <i class="bi bi-clipboard-check"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-stat">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Klienci</div>
                    <div class="stat-value">@Model.TotalClients</div>
                </div>
                <div class="stat-icon" style="background: rgba(16,185,129,0.1); color: var(--success);">
                    <i class="bi bi-people"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-stat">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Zaplanowane dziś</div>
                    <div class="stat-value">@Model.PlannedToday</div>
                </div>
                <div class="stat-icon" style="background: rgba(245,158,11,0.1); color: var(--accent);">
                    <i class="bi bi-calendar-event"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card-stat">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Nowe wiadomości</div>
                    <div class="stat-value">@Model.UnreadMessages</div>
                </div>
                <div class="stat-icon" style="background: rgba(239,68,68,0.1); color: var(--danger);">
                    <i class="bi bi-envelope"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-clipboard-check me-2"></i>Ostatnie zlecenia</h5>
        <a asp-controller="RepairOrder" asp-action="Index" class="btn btn-primary-custom btn-sm">
            Zobacz wszystkie <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>#</th>
                <th>Klient</th>
                <th>Pojazd</th>
                <th>Opis</th>
                <th>Status</th>
                <th>Data</th>
                <th>Akcje</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var order in Model.RecentOrders)
            {
                <tr>
                    <td><strong>#@order.Id</strong></td>
                    <td>@order.Client.FirstName @order.Client.LastName</td>
                    <td>@order.Vehicle.Brand @order.Vehicle.Model (@order.Vehicle.Year)</td>
                    <td>@order.Description</td>
                    <td>
                        @switch (order.Status)
                        {
                            case RepairOrderStatus.New:
                                <span class="badge-status badge-nowe">Nowe</span>
                                break;
                            case RepairOrderStatus.InProgress:
                                <span class="badge-status badge-wtrakcie">W trakcie</span>
                                break;
                            case RepairOrderStatus.Completed:
                                <span class="badge-status badge-gotowe">Gotowe</span>
                                break;
                            case RepairOrderStatus.Cancelled:
                                <span class="badge-status badge-oczekiwanie">Anulowane</span>
                                break;
                        }
                    </td>
                    <td>@order.CreatedAt.ToString("dd.MM.yyyy")</td>
                    <td>
                        <a asp-controller="RepairOrder" asp-action="Edit" asp-route-id="@order.Id"
                           class="btn-action edit"><i class="bi bi-pencil"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
