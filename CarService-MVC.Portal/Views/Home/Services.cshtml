@model List<ServiceCategory>
@{
    ViewData["Title"] = "Usługi";
    var cms = (Dictionary<string, string>)(ViewBag.Cms ?? new Dictionary<string, string>());
    string Cms(string key, string fallback = "") => cms.TryGetValue(key, out var v) ? v : fallback;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/services.css" asp-append-version="true" />
}

<!-- Page Hero -->
<section class="page-hero">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-custom mb-3">
                <li class="breadcrumb-item"><a asp-action="Index">Strona główna</a></li>
                <li class="breadcrumb-item active">Usługi</li>
            </ol>
        </nav>
        <h1 class="fade-up">Nasze <span>usługi</span></h1>
        <p class="fade-up fade-up-delay-1">
            @Cms("intro.subtitle")
        </p>
    </div>
</section>

<!-- Services -->
<section class="services-full-section">
    <div class="container">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-gear-wide"></i>
                <h5>Brak dostępnych usług</h5>
                <p>Wróć wkrótce — uzupełniamy ofertę.</p>
            </div>
        }
        else
        {
            @foreach (var (category, idx) in Model.Select((c, i) => (c, i)))
            {
                <div class="category-block fade-up" style="animation-delay: @(idx * 0.1)s">
                    <div class="category-header">
                        <div class="category-icon-wrap">
                            <i class="bi @(string.IsNullOrEmpty(category.IconCss) ? "bi-gear" : category.IconCss)"></i>
                        </div>
                        <div>
                            <h3 class="category-title">@category.Name</h3>
                            @if (!string.IsNullOrEmpty(category.Description))
                            {
                                <p class="category-desc">@category.Description</p>
                            }
                        </div>
                    </div>
                    <div class="row g-3">
                        @foreach (var service in category.Services)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="service-item-card">
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                        <h6 class="service-item-name mb-0">@service.Name</h6>
                                        <span class="price-badge">od @service.EstimatedPrice.ToString("N0") zł</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(service.Description))
                                    {
                                        <p class="service-item-desc">@service.Description</p>
                                    }
                                    <div class="service-item-meta">
                                        <i class="bi bi-clock"></i> ~@service.EstimatedDuration min
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</section>

