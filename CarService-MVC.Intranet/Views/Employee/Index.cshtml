@model List<Employee>
@{
    ViewData["Title"] = "Pracownicy";
}

<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-person-badge me-2"></i>Lista pracowników</h5>
        <a asp-action="Create" class="btn btn-primary-custom btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Dodaj pracownika
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>#</th>
                <th>Imię i nazwisko</th>
                <th>Stanowisko</th>
                <th>Telefon</th>
                <th>E-mail</th>
                <th>Data zatrudnienia</th>
                <th>Status</th>
                <th>Akcje</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">Brak danych</td>
                </tr>
            }
            @foreach (var employee in Model)
            {
                <tr>
                    <td><strong>@employee.Id</strong></td>
                    <td>@employee.FirstName @employee.LastName</td>
                    <td>@employee.Position</td>
                    <td>@employee.Phone</td>
                    <td>@employee.Email</td>
                    <td>@employee.HireDate.ToString("dd.MM.yyyy")</td>
                    <td>
                        @if (employee.IsActive)
                        {
                            <span class="badge-status badge-nowe">Aktywny</span>
                        }
                        else
                        {
                            <span class="badge-status badge-anulowane">Nieaktywny</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@employee.Id" class="btn-action edit"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="@employee.Id" class="btn-action delete"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
