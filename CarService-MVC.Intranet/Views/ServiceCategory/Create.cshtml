@{
    ViewData["Title"] = "Dodaj kategorię";
    var availableIcons = new[]
    {
        "bi-wrench", "bi-wrench-adjustable", "bi-tools", "bi-gear", "bi-gear-wide-connected",
        "bi-car-front", "bi-car-front-fill", "bi-truck", "bi-fuel-pump", "bi-speedometer2",
        "bi-disc", "bi-lightning-charge", "bi-battery-half", "bi-thermometer-half",
        "bi-droplet", "bi-wind", "bi-snow", "bi-sun", "bi-fire", "bi-cpu",
        "bi-shield-check", "bi-clipboard-check", "bi-hammer", "bi-stars", "bi-camera"
    };
}

<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-folder me-2"></i>Dodaj kategorię usług</h5>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Wróć
        </a>
    </div>
    <div class="p-4">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label class="form-label">Nazwa</label>
                <input name="Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Opis</label>
                <textarea name="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Ikona</label>
                <input type="hidden" name="IconCss" id="iconCssInput" value="" />
                <div id="iconPicker" class="d-flex flex-wrap gap-2 p-3 border rounded bg-light">
                    @foreach (var icon in availableIcons)
                    {
                        <button type="button" class="btn btn-outline-secondary icon-opt" data-icon="bi @icon" title="@icon">
                            <i class="bi @icon fs-5"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary-custom">Zapisz</button>
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/ServiceCategory/icon-picker.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/ServiceCategory/icon-picker.js" asp-append-version="true"></script>
}
