@{
    ViewData["Title"] = "Strona główna";
    var cms = (Dictionary<string, string>)(ViewBag.Cms ?? new Dictionary<string, string>());
    string Cms(string key, string fallback = "") => cms.TryGetValue(key, out var v) ? v : fallback;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/index.css" asp-append-version="true"/>
}

<section class="hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 fade-up">
                <p class="text-uppercase fw-bold mb-3"
                   style="color: var(--accent); letter-spacing: 2px; font-size: 0.85rem;">
                    <i class="bi bi-wrench-adjustable-circle"></i> Profesjonalny serwis
                </p>
                <h1>
                    Twój samochód<br/>
                    w <span>dobrych rękach</span>
                </h1>
                <p class="lead mt-4">
                    @Cms("hero.lead")
                </p>
                <div class="d-flex gap-3 mt-4">
                    <a asp-controller="Home" asp-action="Book" class="btn-cta-lg">
                        <i class="bi bi-calendar-check"></i> Umów wizytę
                    </a>
                    <a asp-controller="Home" asp-action="Services" class="btn-outline-light-custom">
                        Nasze usługi <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div class="hero-stats">
                    <div>
                        <div class="stat-number">15+</div>
                        <div class="stat-label">Lat doświadczenia</div>
                    </div>
                    <div>
                        <div class="stat-number">8k+</div>
                        <div class="stat-label">Naprawionych aut</div>
                    </div>
                    <div>
                        <div class="stat-number">4.9</div>
                        <div class="stat-label">Ocena klientów</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 offset-lg-1 mt-5 mt-lg-0 fade-up fade-up-delay-2">
                <div class="hero-image-box">
                    <div class="hero-card mb-3">
                        <div class="icon-circle">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <h5 class="fw-bold">Gwarancja na naprawy</h5>
                        <p class="mb-0" style="color: rgba(255,255,255,0.6); font-size: 0.95rem;">
                            @Cms("hero.guarantee.desc")
                        </p>
                    </div>
                    <div class="hero-card">
                        <div class="icon-circle" style="background: var(--accent);">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <h5 class="fw-bold">Szybka realizacja</h5>
                        <p class="mb-0" style="color: rgba(255,255,255,0.6); font-size: 0.95rem;">
                            @Cms("hero.fast.desc")
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<section class="section-why">
    <div class="container">
        <div class="text-center mb-5 fade-up">
            <h2 class="section-title">Dlaczego <span>my</span>?</h2>
            <p class="section-subtitle mx-auto mt-3">
                @Cms("why.subtitle")
            </p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3 fade-up fade-up-delay-1">
                <div class="why-card">
                    <div class="why-icon" style="background: rgba(37,99,235,0.1); color: var(--primary);">
                        <i class="bi bi-award"></i>
                    </div>
                    <h5>Doświadczenie</h5>
                    <p>@Cms("why.experience")</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 fade-up fade-up-delay-2">
                <div class="why-card">
                    <div class="why-icon" style="background: rgba(245,158,11,0.1); color: var(--accent);">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h5>Gwarancja 12 mies.</h5>
                    <p>@Cms("why.guarantee")</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 fade-up fade-up-delay-3">
                <div class="why-card">
                    <div class="why-icon" style="background: rgba(16,185,129,0.1); color: #10b981;">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <h5>Uczciwe ceny</h5>
                    <p>@Cms("why.prices")</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 fade-up fade-up-delay-4">
                <div class="why-card">
                    <div class="why-icon" style="background: rgba(139,92,246,0.1); color: #8b5cf6;">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                    <h5>Szybka realizacja</h5>
                    <p>@Cms("why.speed")</p>
                </div>
            </div>
        </div>
    </div>
</section>


<section class="section-services">
    <div class="container">
        <div class="text-center mb-5 fade-up">
            <h2 class="section-title">Nasze <span>usługi</span></h2>
            <p class="section-subtitle mx-auto mt-3">
                @Cms("services.subtitle")
            </p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4 fade-up fade-up-delay-1">
                <div class="service-card">
                    <div class="service-icon">
                        <i class="bi bi-wrench"></i>
                    </div>
                    <h5>Mechanika</h5>
                    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 fade-up fade-up-delay-2">
                <div class="service-card">
                    <div class="service-icon" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
                        <i class="bi bi-circle"></i>
                    </div>
                    <h5>Opony</h5>
                    <p>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 fade-up fade-up-delay-3">
                <div class="service-card">
                    <div class="service-icon" style="background: linear-gradient(135deg, #10b981, #059669);">
                        <i class="bi bi-pc-display"></i>
                    </div>
                    <h5>Diagnostyka</h5>
                    <p>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 fade-up fade-up-delay-3">
                <div class="service-card">
                    <div class="service-icon" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed);">
                        <i class="bi bi-lightning"></i>
                    </div>
                    <h5>Elektryka</h5>
                    <p>Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 fade-up fade-up-delay-4">
                <div class="service-card">
                    <div class="service-icon" style="background: linear-gradient(135deg, #06b6d4, #0891b2);">
                        <i class="bi bi-snow"></i>
                    </div>
                    <h5>Klimatyzacja</h5>
                    <p>Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit sed quia.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 fade-up fade-up-delay-5">
                <div class="service-card">
                    <div class="service-icon" style="background: linear-gradient(135deg, #ef4444, #dc2626);">
                        <i class="bi bi-search"></i>
                    </div>
                    <h5>Przeglądy</h5>
                    <p>Quis autem vel eum iure reprehenderit qui in ea voluptate velit esse quam nihil molestiae.</p>
                </div>
            </div>
        </div>
        <div class="text-center mt-5 fade-up">
            <a asp-controller="Home" asp-action="Services" class="btn btn-outline-primary btn-lg px-4">
                Zobacz pełną ofertę <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</section>


<section class="section-cta">
    <div class="container position-relative" style="z-index:1;">
        <div class="row align-items-center">
            <div class="col-lg-7 fade-up">
                <h2>Potrzebujesz naprawy?<br/>Umów się <span style="color: var(--accent);">już dziś</span></h2>
                <p class="mt-3">
                    @Cms("cta.text")
                </p>
            </div>
            <div class="col-lg-5 text-lg-end mt-4 mt-lg-0 fade-up fade-up-delay-2">
                <a asp-controller="Home" asp-action="Book" class="btn-cta-lg me-3">
                    <i class="bi bi-calendar-check"></i> Umów wizytę
                </a>
                <a asp-controller="Home" asp-action="Contact" class="btn-outline-light-custom">
                    <i class="bi bi-telephone"></i> Zadzwoń
                </a>
            </div>
        </div>
    </div>
</section>


