@model ErrorViewModel
@{
    var code = ViewBag.StatusCode as int?;
    var is404 = code == 404;
    ViewData["Title"] = is404 ? "Nie znaleziono" : "Błąd";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="text-center">
        @if (is404)
        {
            <i class="bi bi-search" style="font-size: 4rem; color: var(--warning, #ffc107);"></i>
            <h2 class="mt-3">404 — Nie znaleziono strony</h2>
            <p class="text-muted mb-4">Strona, której szukasz, nie istnieje lub została przeniesiona.</p>
        }
        else
        {
            <i class="bi bi-exclamation-triangle" style="font-size: 4rem; color: var(--danger, #dc3545);"></i>
            <h2 class="mt-3">Ups! Coś poszło nie tak.</h2>
            <p class="text-muted mb-4">Wystąpił nieoczekiwany błąd podczas przetwarzania żądania.</p>
        }
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">
                <strong>ID żądania:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary-custom mt-2">
            <i class="bi bi-house me-1"></i> Wróć do panelu
        </a>
    </div>
</div>
