@{
    ViewData["Title"] = "Pojazdy";
}

<div class="table-card">
    <div class="table-header">
        <h5><i class="bi bi-car-front me-2"></i>Lista pojazdów</h5>
        <a asp-action="Create" class="btn btn-primary-custom btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Dodaj pojazd
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>#</th>
                <th>Klient</th>
                <th>Marka / Model</th>
                <th>Rok</th>
                <th>Rejestracja</th>
                <th>Silnik</th>
                <th>Akcje</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td colspan="7" class="text-center text-muted py-4">Brak danych</td>
            </tr>
            </tbody>
        </table>
    </div>
</div>
