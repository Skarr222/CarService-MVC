@model ContactRequest?
@{
    ViewData["Title"] = "Kontakt";
    var cms = CmsHelper.FromViewBag(ViewData);
    string? error = ViewBag.Error;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/contact.css" asp-append-version="true"/>
}

<section class="page-hero">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-custom mb-3">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Strona główna</a></li>
                <li class="breadcrumb-item active">Kontakt</li>
            </ol>
        </nav>
        <h1 class="fade-up">Skontaktuj się <span>z nami</span></h1>
        <p class="fade-up fade-up-delay-1">
            @cms.Get("intro.subtitle")
        </p>
    </div>
</section>
<section class="contact-section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-4 fade-up">
                <div class="contact-info-block">
                    <h4 class="contact-info-title">Dane kontaktowe</h4>
                    <div class="contact-info-item">
                        <div class="contact-info-icon" style="background:rgba(37,99,235,0.1);color:var(--primary)">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>
                        <div>
                            <div class="contact-info-label">Adres</div>
                            <div class="contact-info-value">@Html.Raw(cms.Get("address"))</div>
                        </div>
                    </div>
                    <div class="contact-info-item">
                        <div class="contact-info-icon" style="background:rgba(245,158,11,0.1);color:var(--accent)">
                            <i class="bi bi-telephone-fill"></i>
                        </div>
                        <div>
                            <div class="contact-info-label">Telefon</div>
                            <a href="tel:@cms.Get("phone")" class="contact-info-value contact-link">
                                @cms.Get("phone")
                            </a>
                        </div>
                    </div>
                    <div class="contact-info-item">
                        <div class="contact-info-icon" style="background:rgba(16,185,129,0.1);color:#10b981">
                            <i class="bi bi-envelope-fill"></i>
                        </div>
                        <div>
                            <div class="contact-info-label">E-mail</div>
                            <a href="mailto:@cms.Get("email")" class="contact-info-value contact-link">
                                @cms.Get("email")
                            </a>
                        </div>
                    </div>
                    <div class="contact-info-item">
                        <div class="contact-info-icon" style="background:rgba(139,92,246,0.1);color:#8b5cf6">
                            <i class="bi bi-clock-fill"></i>
                        </div>
                        <div>
                            <div class="contact-info-label">Godziny otwarcia</div>
                            <div class="contact-info-value">@Html.Raw(cms.Get("hours"))</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8 fade-up fade-up-delay-2">
                <div class="contact-form-card">
                    <h4 class="form-card-title">Wyślij wiadomość</h4>
                    <p class="form-card-subtitle">Odpowiemy w ciągu 24 godzin roboczych.</p>
                    @if (TempData["Success"] != null)
                    {
                        <div class="portal-alert portal-alert-success">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="portal-alert portal-alert-error">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @error
                        </div>
                    }
                    <form asp-action="Contact" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label-custom">Imię i nazwisko <span class="required">*</span></label>
                                <input type="text" name="Name" class="form-input-custom"
                                       value="@(Model?.Name)" placeholder="Jan Kowalski" required/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-custom">E-mail <span class="required">*</span></label>
                                <input type="email" name="Email" class="form-input-custom"
                                       value="@(Model?.Email)" placeholder="jan@example.com" required/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-custom">Telefon</label>
                                <input type="tel" name="Phone" class="form-input-custom"
                                       value="@(Model?.Phone)" placeholder="+48 600 100 200"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-custom">Temat</label>
                                <input type="text" name="Subject" class="form-input-custom"
                                       value="@(Model?.Subject)" placeholder="W czym możemy pomóc?"/>
                            </div>
                            <div class="col-12">
                                <label class="form-label-custom">Wiadomość <span class="required">*</span></label>
                                <textarea name="Message" class="form-input-custom" rows="5"
                                          placeholder="Opisz sprawę..." required>@(Model?.Message)</textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn-submit">
                                    <i class="bi bi-send"></i> Wyślij wiadomość
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
